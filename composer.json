{
    "name": "canebaycomputers/valorpay",
    "description": "Laravel client for ValorPay: hosted payment pages, transaction lookups, card tokens, subscriptions and webhook hints.",
    "type": "library",
    "keywords": [
        "valorpay",
        "valor paytech",
        "payments",
        "laravel",
        "recurring billing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cane Bay Computers",
            "homepage": "https://canebaycomputers.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CaneBayComputers\\ValorPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaneBayComputers\\ValorPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CaneBayComputers\\ValorPay\\ValorPayServiceProvider"
            ],
            "aliases": {
                "ValorPay": "CaneBayComputers\\ValorPay\\Facades\\ValorPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
